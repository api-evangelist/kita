                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documents\": [\n    {\n      \"file_url\": \"<uri>\",\n      \"document_type\": \"<string>\",\n      \"filename\": \"<string>\"\n    },\n    {\n      \"file_url\": \"<uri>\",\n      \"document_type\": \"<string>\",\n      \"filename\": \"<string>\"\n    }\n  ],\n  \"webhook_url\": \"<uri>\"\n}",
