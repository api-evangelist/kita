{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kita Capture Applications Batch API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Batch",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Process documents from URLs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://portal.usekita.com/api/v1/batch",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit up to 100 documents by URL in a single request. Each entry requires `file_url` and `document_type`; optional `filename` overrides auto-detection. Batch processing requires a paid plan."
        },
        {
          "info": {
            "name": "Get batch status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://portal.usekita.com/api/v1/batch/:batchId",
            "params": [
              {
                "name": "batchId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get batch status"
        },
        {
          "info": {
            "name": "Get results for every document in a batch",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://portal.usekita.com/api/v1/batch/:batchId/results",
            "params": [
              {
                "name": "batchId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get results for every document in a batch"
        }
      ]
    }
  ],
  "bundled": true
}