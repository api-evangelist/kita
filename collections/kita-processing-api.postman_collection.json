          "id": "baa2fd1f-5ad4-4805-8797-6cc6bd7f2980",
          "name": "Submit a document for extraction",
          "request": {
            "name": "Submit a document for extraction",
            "description": {
              "content": "Accepts two upload modes on the same URL. Multipart sends the raw `file` plus a\n`document_type`. JSON sends `file_base64` (a data-URI prefix is accepted and stripped)\nplus `filename` and `document_type`. Returns a `documentId` to poll. An optional\none-shot `webhook_url` delivers the result instead of polling.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "process-async"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) PDF, PNG, JPG, TIFF or BMP."
                },
                {
                  "key": "document_type",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) "
                },
                {
                  "key": "password",
                  "value": "<string>",
                  "type": "text",
                  "description": "PDF password if the file is encrypted."
                },
                {
                  "key": "webhook_url",
                  "value": "<uri>",
                  "type": "text",
                  "description": "One-shot delivery URL for this upload."
                }
              ]
            }
          },
