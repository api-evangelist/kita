{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kita Capture Applications Folders API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Folders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List folders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://portal.usekita.com/api/v1/folders"
          },
          "docs": "List folders"
        },
        {
          "info": {
            "name": "Create a folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://portal.usekita.com/api/v1/folders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Folders are containers for grouping documents, e.g. by applicant."
        },
        {
          "info": {
            "name": "List documents in a folder",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://portal.usekita.com/api/v1/folders/:folderId/documents",
            "params": [
              {
                "name": "folderId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List documents in a folder"
        }
      ]
    }
  ],
  "bundled": true
}