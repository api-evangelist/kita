{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kita Capture Applications API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Applications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create an application and upload documents in one call",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://portal.usekita.com/intake",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "One-call create plus document upload. Send `multipart/form-data` with an `application`\nfield carrying the JSON metadata plus repeated `file`/`files` parts, or\n`application/json` for metadata only. Pass `external_ref` for idempotency — a retried\npush returns the existing application with `\"idempotent\": true` and HTTP 200 instead\nof creating a duplicate.\n"
        },
        {
          "info": {
            "name": "List applications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://portal.usekita.com/applications",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Page size. Default 50, clamped to 1–200."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List applications for the calling organization, with offset pagination."
        },
        {
          "info": {
            "name": "Create an application",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://portal.usekita.com/applications",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create application metadata only. Documents are uploaded separately."
        },
        {
          "info": {
            "name": "Get an application",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://portal.usekita.com/applications/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Application UUID or human `app_id` (e.g. `APP-1234`)."
              }
            ]
          },
          "docs": "Fetch a single application by UUID or human `app_id`. Includes `document_count`."
        },
        {
          "info": {
            "name": "Update an application",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://portal.usekita.com/applications/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Application UUID or human `app_id` (e.g. `APP-1234`)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update mutable fields — business_name, loan_type, loan_amount, application_context, status."
        },
        {
          "info": {
            "name": "Delete an application",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://portal.usekita.com/applications/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Application UUID or human `app_id` (e.g. `APP-1234`)."
              }
            ]
          },
          "docs": "Permanently deletes the application, its documents and storage, and the borrower if orphaned."
        }
      ]
    }
  ],
  "bundled": true
}